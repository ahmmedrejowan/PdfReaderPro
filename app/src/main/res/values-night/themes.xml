<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme - minimal for Compose app. AppCompat, because the activities
         extend AppCompatActivity for per-app language before Android 13. (night) -->
    <style name="Theme.PDFReaderPro" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme for Android 12+ Splash Screen API (night) -->
    <style name="Theme.PDFReaderPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bgColor</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/img_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PDFReaderPro</item>
    </style>

</resources>
